{
  "name": "nexuspanel",
  "version": "1.0.0",
  "description": "Lightweight cross-platform Minecraft server panel with the ASF (Advanced Sandbox Fabric) isolation protocol, secure server management, and safe change planning.",
  "main": "backend/index.js",
  "bin": {
    "nexuspanel": "backend/cli.js"
  },
  "scripts": {
    "start": "node backend/launcher.js",
    "foreground": "node backend/index.js",
    "dev": "node --watch backend/index.js",
    "service:install": "node backend/service.js install",
    "service:uninstall": "node backend/service.js uninstall",
    "service:status": "node backend/service.js status",
    "service:logs": "journalctl -u nexuspanel -f",
    "cli": "node backend/cli.js",
    "update": "bash update/update.sh",
    "test": "npm run test:auth && npm run test:v3 && npm run test:security && npm run test:advanced && npm run test:exploit && npm run test:asf",
    "test:auth": "node tests/auth.test.js",
    "test:v3": "node tests/v3.test.js && node tests/setup.test.js",
    "test-auth": "npm run test:auth",
    "debug-users": "node scripts/debug-users.js",
    "reset-password": "node scripts/reset-password.js",
    "build:asf": "node backend/asf_native.js",
    "build:host-agent": "node backend/host_agent.js",
    "test:asf": "bash native/asf/tests/test.sh",
    "audit:asf": "sudo bash native/asf/tests/test-audit.sh",
    "benchmark:asf": "bash native/asf/tests/benchmark.sh",
    "test:security": "node tests/security-regression.test.js",
    "test:exploit": "node tests/security-exploit.test.js",
    "test:advanced": "node tests/advanced-ops.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0 <25",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^11.0.0"
  }
}
